      "factor": "QDII 溢价过滤",
      "role": "建仓闸门",
      "rule": "两只 QDII ETF 溢价较高者 > 2% 时，该月不建股票仓（激进追高保护）。",
      "param": "阈值=2.0%"
    },
    {
      "factor": "回撤熔断",
      "role": "组合层风控",
